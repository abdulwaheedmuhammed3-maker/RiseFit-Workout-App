{
  "name": "risefit-workout-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-mediapipe-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "cap sync android && node scripts/prepare-android.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/local-notifications": "^7.0.3",
    "@mediapipe/tasks-vision": "^0.10.22",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "5.1.0"
  }
}
